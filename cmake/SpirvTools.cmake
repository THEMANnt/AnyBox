function(anybox_add_spirv_tools)
    set(SPIRV-Headers_SOURCE_DIR "${CMAKE_SOURCE_DIR}/3rdparty/SPIRV-Headers")
    set(SPIRV_SKIP_EXECUTABLES ON)
    set(SPIRV_SKIP_TESTS ON)
    set(SPIRV_TOOLS_BUILD_STATIC ON)
    set(SPIRV_TOOLS_BUILD_SHARED OFF)
    set(SPIRV_WERROR OFF)
    set(BUILD_SHARED_LIBS OFF)
    add_subdirectory("${CMAKE_SOURCE_DIR}/3rdparty/SPIRV-Tools" "${CMAKE_BINARY_DIR}/3rdparty/SPIRV-Tools" EXCLUDE_FROM_ALL)
endfunction()
