if(MSVC AND CMAKE_C_COMPILER_ID STREQUAL "Clang")
    get_target_property(opusSources opus SOURCES)
    foreach(source IN LISTS opusSources)
        if(source MATCHES "_sse4_1\\.c$")
            get_filename_component(sourcePath "${source}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}/3rdparty/opus")
            set_property(SOURCE "${sourcePath}" TARGET_DIRECTORY opus APPEND PROPERTY COMPILE_OPTIONS -msse4.1)
        endif()
    endforeach()
endif()
