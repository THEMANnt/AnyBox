function(anybox_add_ffmpeg_component component)
    set(sourceRoot "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../3rdparty/ffmpeg")
    file(STRINGS "${sourceRoot}/lib${component}/premake5.lua" sourceLines REGEX "^[ \t]*\"[^\" ]+\\.c\"")
    set(sources)
    foreach(line IN LISTS sourceLines)
        string(REGEX MATCH "\"([^\"]+\\.c)\"" match "${line}")
        set(source "${CMAKE_MATCH_1}")
        if(source MATCHES "^aarch64/")
            continue()
        endif()
        list(APPEND sources "${sourceRoot}/lib${component}/${source}")
    endforeach()
    if(NOT sources)
        message(FATAL_ERROR "FFmpeg ${component} source list is empty")
    endif()
    add_library(anybox_ffmpeg_${component} STATIC ${sources})
    if(MINGW)
        set(configDirectory "${CMAKE_CURRENT_BINARY_DIR}/ffmpeg-config")
        file(READ "${sourceRoot}/config_windows_x86_64.h" configuration)
        string(REPLACE "#define HAVE_LIBC_MSVCRT 1" "#define HAVE_LIBC_MSVCRT 0" configuration "${configuration}")
        file(MAKE_DIRECTORY "${configDirectory}")
        file(CONFIGURE OUTPUT "${configDirectory}/config.h" CONTENT "${configuration}" @ONLY)
        target_include_directories(anybox_ffmpeg_${component} BEFORE PRIVATE "${configDirectory}")
    endif()
    target_include_directories(anybox_ffmpeg_${component} SYSTEM PUBLIC "${sourceRoot}")
    target_include_directories(anybox_ffmpeg_${component} PRIVATE "${sourceRoot}/compat/atomics/win32")
    target_compile_definitions(anybox_ffmpeg_${component} PRIVATE HAVE_AV_CONFIG_H _USE_MATH_DEFINES _CRT_SECURE_NO_WARNINGS _CRT_NONSTDC_NO_WARNINGS)
    target_compile_features(anybox_ffmpeg_${component} PRIVATE c_std_11)
    if(MSVC)
        target_compile_options(anybox_ffmpeg_${component} PRIVATE /W0 /O2)
    else()
        target_compile_options(anybox_ffmpeg_${component} PRIVATE -w -O2)
    endif()
endfunction()

anybox_add_ffmpeg_component(avutil)
anybox_add_ffmpeg_component(avcodec)
target_link_libraries(anybox_ffmpeg_avutil PRIVATE bcrypt)
target_link_libraries(anybox_ffmpeg_avcodec PRIVATE anybox_ffmpeg_avutil)
