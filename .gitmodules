[submodule "3rdparty/anyps5"]
	path = 3rdparty/anyps5
	url = https://github.com/boykopovar/AnyPS5.git
[submodule "3rdparty/SPIRV-Headers"]
	path = 3rdparty/SPIRV-Headers
